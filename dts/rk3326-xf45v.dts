    gpio-leds {
        compatible = "gpio-leds";
        pinctrl-0 = <0xAB>;
        pinctrl-names = "default";
        phandle = <0x13C>;
        led-0 {
            color = <0x1>;
            default-state = "off";
            function = "charging";
            linux,default-trigger = "none";
            gpios = <0x53 0x11 0x0>;
        };
        led-1 {
            color = <0x3>;
            default-state = "on";
            function = "power";
            linux,default-trigger = "default-on";
            gpios = <0x53 0x0 0x0>;
        };
    };
    audio-amplifier {
        compatible = "simple-audio-amplifier";
        enable-gpios = <0x94 0x7 0x0>;
        pinctrl-0 = <0xAC>;
        pinctrl-names = "default";
        sound-name-prefix = "Speaker Amp";
        phandle = <0xAE>;
    };
    rk817-sound-amplified {
        compatible = "simple-audio-card";
        pinctrl-names = "default";
        pinctrl-0 = <0xAD>;
        simple-audio-card,name = "rk817_ext";
        simple-audio-card,aux-devs = <0xAE>;
        simple-audio-card,format = "i2s";
        simple-audio-card,hp-det-gpios = <0xAA 0x16 0x0>;
        simple-audio-card,mclk-fs = <0x100>;
        simple-audio-card,widgets = "Headphone", "Headphones", "Speaker", "Internal Speakers";
        simple-audio-card,routing = "Headphones", "HPOL", "Headphones", "HPOR", "Internal Speakers", "Speaker Amp OUTL", "Internal Speakers", "Speaker Amp OUTR", "Speaker Amp INL", "HPOL", "Speaker Amp INR", "HPOR";
        simple-audio-card,pin-switches = "Internal Speakers";
        status = "okay";
        simple-audio-card,codec {
            sound-dai = <0xAF>;
        };
        simple-audio-card,cpu {
            sound-dai = <0xB0>;
        };
    };
    rk817-sound-simple {
        compatible = "simple-audio-card";
        pinctrl-names = "default";
        pinctrl-0 = <0xAD>;
        simple-audio-card,name = "rk817_ext";
        simple-audio-card,format = "i2s";
        simple-audio-card,hp-det-gpios = <0xAA 0x16 0x0>;
        simple-audio-card,mclk-fs = <0x100>;
        simple-audio-card,widgets = "Headphone", "Headphones", "Speaker", "Internal Speakers";
        simple-audio-card,routing = "Headphones", "HPOL", "Headphones", "HPOR", "Internal Speakers", "SPKO";
        status = "disabled";
        simple-audio-card,codec {
            sound-dai = <0xAF>;
        };
        simple-audio-card,cpu {
            sound-dai = <0xB0>;
        };
    };
    vccsys {
        compatible = "regulator-fixed";
        regulator-name = "vcc5v0_sys";
        regulator-always-on;
        regulator-boot-on;
        regulator-min-microvolt = <0x4C4B40>;
        regulator-max-microvolt = <0x4C4B40>;
        phandle = <0x56>;
    };
    vcc-phy-regulator {
        compatible = "regulator-fixed";
        regulator-name = "vcc_phy";
        regulator-always-on;
        regulator-boot-on;
    };
    vcc18-lcd0 {
        compatible = "regulator-fixed";
        regulator-name = "vcc18_lcd0_n";
        gpio = <0x53 0xD 0x0>;
        enable-active-high;
        pinctrl-0 = <0xB1>;
        pinctrl-names = "default";
        regulator-boot-on;
        phandle = <0x92>;
        regulator-state-mem {
            regulator-off-in-suspend;
        };
    };
    vcc_host {
        compatible = "regulator-fixed";
        regulator-name = "vcc_host";
        regulator-min-microvolt = <0x4C4B40>;
        regulator-max-microvolt = <0x4C4B40>;
        gpio = <0x94 0x4 0x0>;
        pinctrl-0 = <0xB2>;
        pinctrl-names = "default";
        enable-active-high;
        regulator-always-on;
        regulator-boot-on;
        vin-supply = <0xB3>;
        phandle = <0x13D>;
    };
