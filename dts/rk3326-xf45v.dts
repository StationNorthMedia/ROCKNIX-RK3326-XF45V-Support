/dts-v1/;
// version: 17
// last_comp_version: 16
// boot_cpuid_phys: 0x0

/ {
    compatible = "gameconsole,eeclone", "rockchip,rk3326";
    interrupt-parent = <0x1>;
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    model = "Generic EE clone";
    aliases {
        i2c0 = "/i2c@ff180000";
        i2c1 = "/i2c@ff190000";
        i2c2 = "/i2c@ff1a0000";
        i2c3 = "/i2c@ff1b0000";
        serial0 = "/serial@ff030000";
        serial1 = "/serial@ff160000";
        serial2 = "/serial@ff178000";
        serial3 = "/serial@ff168000";
        serial4 = "/serial@ff170000";
        serial5 = "/serial@ff178000";
        spi0 = "/spi@ff1d0000";
        spi1 = "/spi@ff1d8000";
        mmc0 = "/mmc@ff390000";
        mmc1 = "/mmc@ff370000";
        mmc2 = "/mmc@ff380000";
    };
    cpus {
        #address-cells = <0x2>;
        #size-cells = <0x0>;
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x0>;
            enable-method = "psci";
            clocks = <0x2 0x7>;
            #cooling-cells = <0x2>;
            cpu-idle-states = <0x3 0x4>;
            dynamic-power-coefficient = <0x5A>;
            operating-points-v2 = <0x5>;
            cpu-supply = <0x6>;
            phandle = <0x7>;
        };
        cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x1>;
            enable-method = "psci";
            clocks = <0x2 0x7>;
            #cooling-cells = <0x2>;
            cpu-idle-states = <0x3 0x4>;
            dynamic-power-coefficient = <0x5A>;
            operating-points-v2 = <0x5>;
            cpu-supply = <0x6>;
            phandle = <0x8>;
        };
        cpu@2 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x2>;
            enable-method = "psci";
            clocks = <0x2 0x7>;
            #cooling-cells = <0x2>;
            cpu-idle-states = <0x3 0x4>;
            dynamic-power-coefficient = <0x5A>;
            operating-points-v2 = <0x5>;
            cpu-supply = <0x6>;
            phandle = <0x9>;
        };
        cpu@3 {
            device_type = "cpu";
            compatible = "arm,cortex-a35";
            reg = <0x0 0x3>;
            enable-method = "psci";
            clocks = <0x2 0x7>;
            #cooling-cells = <0x2>;
            cpu-idle-states = <0x3 0x4>;
            dynamic-power-coefficient = <0x5A>;
            operating-points-v2 = <0x5>;
            cpu-supply = <0x6>;
            phandle = <0xA>;
        };
        idle-states {
            entry-method = "psci";
            cpu-sleep {
                compatible = "arm,idle-state";
                local-timer-stop;
                arm,psci-suspend-param = <0x10000>;
                entry-latency-us = <0x78>;
                exit-latency-us = <0xFA>;
                min-residency-us = <0x384>;
                phandle = <0x3>;
            };
            cluster-sleep {
                compatible = "arm,idle-state";
                local-timer-stop;
                arm,psci-suspend-param = <0x1010000>;
                entry-latency-us = <0x190>;
                exit-latency-us = <0x1F4>;
                min-residency-us = <0x7D0>;
                phandle = <0x4>;
            };
        };
    };
    opp-table-0 {
        compatible = "operating-points-v2";
        opp-shared;
        phandle = <0x5>;
        opp-1008000000 {
            opp-hz = <0x0 0x3C14DC00>;
            opp-microvolt = <0x11EDD8 0x11EDD8 0x149970>;
            clock-latency-ns = <0x9C40>;
        };
        opp-1296000000 {
            opp-hz = <0x0 0x4D3F6400>;
            opp-microvolt = <0x149970 0x149970 0x149970>;
            clock-latency-ns = <0x9C40>;
        };
        opp-1416000000 {
            opp-hz = <0x0 0x54667200>;
            opp-microvolt = <0x149970 0x149970 0x149970>;
            clock-latency-ns = <0x9C40>;
            turbo-mode;
        };
    };
    arm-pmu {
        compatible = "arm,cortex-a35-pmu";
        interrupts = <0x0 0x64 0x4 0x0 0x65 0x4 0x0 0x66 0x4 0x0 0x67 0x4>;
        interrupt-affinity = <0x7 0x8 0x9 0xA>;
    };
    display-subsystem {
        compatible = "rockchip,display-subsystem";
        ports = <0xB>;
        status = "okay";
        phandle = <0xB4>;
    };
    external-gmac-clock {
        compatible = "fixed-clock";
        clock-frequency = <0x2FAF080>;
        clock-output-names = "gmac_clkin";
        #clock-cells = <0x0>;
        phandle = <0xB5>;
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    timer {
        compatible = "arm,armv8-timer";
        interrupts = <0x1 0xD 0xF04 0x1 0xE 0xF04 0x1 0xB 0xF04 0x1 0xA 0xF04>;
    };
    thermal-zones {
        phandle = <0xB6>;
        soc-thermal {
            polling-delay-passive = <0x14>;
            polling-delay = <0x3E8>;
            sustainable-power = <0x2EE>;
            thermal-sensors = <0xC 0x0>;
            phandle = <0xB7>;
            trips {
                trip-point-0 {
                    temperature = <0x11170>;
                    hysteresis = <0x7D0>;
                    type = "passive";
                    phandle = <0xB8>;
                };
                trip-point-1 {
                    temperature = <0x14C08>;
                    hysteresis = <0x7D0>;
                    type = "passive";
                    phandle = <0xD>;
                };
                soc-crit {
                    temperature = <0x1C138>;
                    hysteresis = <0x7D0>;
                    type = "critical";
                    phandle = <0xB9>;
                };
            };
            cooling-maps {
                map0 {
                    trip = <0xD>;
                    cooling-device = <0x7 0xFFFFFFFF 0xFFFFFFFF>;
                    contribution = <0x1000>;
                };
            };
        };
        gpu-thermal {
            polling-delay-passive = <0x64>;
            polling-delay = <0x3E8>;
            thermal-sensors = <0xC 0x1>;
            phandle = <0xBA>;
            trips {
                gpu-threshold {
                    temperature = <0x11170>;
                    hysteresis = <0x7D0>;
                    type = "passive";
                    phandle = <0xBB>;
                };
                gpu-target {
                    temperature = <0x14C08>;
                    hysteresis = <0x7D0>;
                    type = "passive";
                    phandle = <0xE>;
                };
                gpu-crit {
                    temperature = <0x1C138>;
                    hysteresis = <0x7D0>;
                    type = "critical";
                    phandle = <0xBC>;
                };
            };
            cooling-maps {
                map0 {
                    trip = <0xE>;
                    cooling-device = <0xF 0xFFFFFFFF 0xFFFFFFFF>;
                };
            };
        };
    };
    xin24m {
        compatible = "fixed-clock";
        #clock-cells = <0x0>;
        clock-frequency = <0x16E3600>;
        clock-output-names = "xin24m";
        phandle = <0x6F>;
    };
    power-management@ff000000 {
        compatible = "rockchip,px30-pmu", "syscon", "simple-mfd";
        reg = <0x0 0xFF000000 0x0 0x1000>;
        phandle = <0xBD>;
        power-controller {
            compatible = "rockchip,px30-power-controller";
            #power-domain-cells = <0x1>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            phandle = <0x71>;
            power-domain@5 {
                reg = <0x5>;
                clocks = <0x2 0x103 0x2 0x102 0x2 0x3C>;
                pm_qos = <0x10 0x11>;
                #power-domain-cells = <0x0>;
            };
            power-domain@7 {
                reg = <0x7>;
                clocks = <0x2 0xF7 0x2 0x3B>;
                pm_qos = <0x12>;
                #power-domain-cells = <0x0>;
            };
            power-domain@9 {
                reg = <0x9>;
                clocks = <0x2 0xB2 0x2 0x143 0x2 0x40 0x2 0x3F>;
                pm_qos = <0x13>;
                #power-domain-cells = <0x0>;
            };
            power-domain@10 {
                reg = <0xA>;
                clocks = <0x2 0xFE 0x2 0x100 0x2 0xFF 0x2 0x101 0x2 0x39 0x2 0x37 0x2 0x38 0x2 0x3A>;
                pm_qos = <0x14 0x15 0x16 0x17>;
                #power-domain-cells = <0x0>;
            };
            power-domain@11 {
                reg = <0xB>;
                clocks = <0x2 0xAF 0x2 0xF4 0x2 0x4B>;
                pm_qos = <0x18 0x19>;
                #power-domain-cells = <0x0>;
            };
            power-domain@12 {
                reg = <0xC>;
                clocks = <0x2 0xB7 0x2 0xB5 0x2 0xB6 0x2 0x96 0x2 0x97 0x2 0xFD 0x2 0xFB 0x2 0xFC 0x2 0x144 0x2 0x35 0x2 0x36>;
                pm_qos = <0x1A 0x1B 0x1C 0x1D>;
                #power-domain-cells = <0x0>;
            };
            power-domain@13 {
                reg = <0xD>;
                clocks = <0x2 0xB3 0x2 0xB4 0x2 0xF9 0x2 0xFA 0x2 0x33>;
                pm_qos = <0x1E 0x1F 0x20 0x21 0x22>;
                #power-domain-cells = <0x0>;
            };
            power-domain@14 {
                reg = <0xE>;
                clocks = <0x2 0x49>;
                pm_qos = <0x23>;
                #power-domain-cells = <0x0>;
            };
        };
    };
    syscon@ff010000 {
        compatible = "rockchip,px30-pmugrf", "syscon", "simple-mfd";
        reg = <0x0 0xFF010000 0x0 0x1000>;
        phandle = <0x9C>;
        io-domains {
            compatible = "rockchip,px30-pmu-io-voltage-domain";
            status = "okay";
            pmuio1-supply = <0x24>;
            pmuio2-supply = <0x24>;
            phandle = <0xBE>;
        };
        reboot-mode {
            compatible = "syscon-reboot-mode";
            offset = <0x200>;
            mode-bootloader = <0x5242C301>;
            mode-fastboot = <0x5242C309>;
            mode-loader = <0x5242C301>;
            mode-normal = <0x5242C300>;
            mode-recovery = <0x5242C303>;
        };
    };
    serial@ff030000 {
        compatible = "rockchip,px30-uart", "snps,dw-apb-uart";
        reg = <0x0 0xFF030000 0x0 0x100>;
        interrupts = <0x0 0xF 0x4>;
        clocks = <0x25 0x6 0x25 0x15>;
        clock-names = "baudclk", "apb_pclk";
        dmas = <0x26 0x0 0x26 0x1>;
        dma-names = "tx", "rx";
        reg-shift = <0x2>;
        reg-io-width = <0x4>;
        pinctrl-names = "default";
        pinctrl-0 = <0x27 0x28 0x29>;
        status = "disabled";
        phandle = <0xBF>;
    };
    i2s@ff060000 {
        compatible = "rockchip,px30-i2s-tdm";
        reg = <0x0 0xFF060000 0x0 0x1000>;
        interrupts = <0x0 0xC 0x4>;
        clocks = <0x2 0x10 0x2 0x12 0x2 0x106>;
        clock-names = "mclk_tx", "mclk_rx", "hclk";
        dmas = <0x26 0x10 0x26 0x11>;
        dma-names = "tx", "rx";
        rockchip,grf = <0x2A>;
        resets = <0x2 0x84 0x2 0xBF>;
        reset-names = "tx-m", "rx-m";
        pinctrl-names = "default";
        pinctrl-0 = <0x2B 0x2C 0x2D 0x2E 0x2F 0x30 0x31 0x32 0x33 0x34 0x35 0x36>;
        #sound-dai-cells = <0x0>;
        status = "disabled";
        phandle = <0xC0>;
    };
    i2s@ff070000 {
        compatible = "rockchip,px30-i2s", "rockchip,rk3066-i2s";
        reg = <0x0 0xFF070000 0x0 0x1000>;
        interrupts = <0x0 0xD 0x4>;
        clocks = <0x2 0x14 0x2 0x107>;
        clock-names = "i2s_clk", "i2s_hclk";
        dmas = <0x26 0x12 0x26 0x13>;
        dma-names = "tx", "rx";
        pinctrl-names = "default";
        pinctrl-0 = <0x37 0x38 0x39 0x3A>;
        #sound-dai-cells = <0x0>;
        status = "okay";
        phandle = <0xB0>;
    };
    i2s@ff080000 {
        compatible = "rockchip,px30-i2s", "rockchip,rk3066-i2s";
        reg = <0x0 0xFF080000 0x0 0x1000>;
        interrupts = <0x0 0xE 0x4>;
        clocks = <0x2 0x16 0x2 0x108>;
        clock-names = "i2s_clk", "i2s_hclk";
        dmas = <0x26 0x14 0x26 0x15>;
        dma-names = "tx", "rx";
        pinctrl-names = "default";
        pinctrl-0 = <0x3B 0x3C 0x3D 0x3E>;
        #sound-dai-cells = <0x0>;
        status = "disabled";
        phandle = <0xC1>;
    };
    interrupt-controller@ff131000 {
        compatible = "arm,gic-400";
        #interrupt-cells = <0x3>;
        #address-cells = <0x0>;
        interrupt-controller;
        reg = <0x0 0xFF131000 0x0 0x1000 0x0 0xFF132000 0x0 0x2000 0x0 0xFF134000 0x0 0x2000 0x0 0xFF136000 0x0 0x2000>;
        interrupts = <0x1 0x9 0xF04>;
        phandle = <0x1>;
    };
    syscon@ff140000 {
        compatible = "rockchip,px30-grf", "syscon", "simple-mfd";
        reg = <0x0 0xFF140000 0x0 0x1000>;
        phandle = <0x2A>;
        io-domains {
            compatible = "rockchip,px30-io-voltage-domain";
            status = "okay";
            vccio1-supply = <0x3F>;
            vccio2-supply = <0x40>;
            vccio3-supply = <0x41>;
            vccio4-supply = <0x42>;
            vccio5-supply = <0x42>;
            vccio6-supply = <0x41>;
            phandle = <0xC2>;
        };
        lvds {
            compatible = "rockchip,px30-lvds";
            phys = <0x43>;
            phy-names = "dphy";
            rockchip,grf = <0x2A>;
            rockchip,output = "lvds";
            status = "disabled";
            phandle = <0xC3>;
            ports {
                #address-cells = <0x1>;
                #size-cells = <0x0>;
                port@0 {
                    reg = <0x0>;
                    #address-cells = <0x1>;
                    #size-cells = <0x0>;
                    phandle = <0xC4>;
                    endpoint@0 {
                        reg = <0x0>;
                        remote-endpoint = <0x44>;
                        phandle = <0x99>;
                    };
                };
                port@1 {
                    reg = <0x1>;
                    phandle = <0xC5>;
                };
            };
        };
    };
    serial@ff158000 {
        compatible = "rockchip,px30-uart", "snps,dw-apb-uart";
        reg = <0x0 0xFF158000 0x0 0x100>;
        interrupts = <0x0 0x10 0x4>;
        clocks = <0x2 0x18 0x2 0x149>;
        clock-names = "baudclk", "apb_pclk";
        dmas = <0x26 0x2 0x26 0x3>;
        dma-names = "tx", "rx";
        reg-shift = <0x2>;
        reg-io-width = <0x4>;
        pinctrl-names = "default";
        pinctrl-0 = <0x45 0x46 0x47>;
        status = "disabled";
        phandle = <0xC6>;
    };
    serial@ff160000 {
        compatible = "rockchip,px30-uart", "snps,dw-apb-uart";
        reg = <0x0 0xFF160000 0x0 0x100>;
        interrupts = <0x0 0x11 0x4>;
        clocks = <0x2 0x19 0x2 0x14A>;
        clock-names = "baudclk", "apb_pclk";
        dmas = <0x26 0x4 0x26 0x5>;
        dma-names = "tx", "rx";
        reg-shift = <0x2>;
        reg-io-width = <0x4>;
        pinctrl-names = "default";
        pinctrl-0 = <0x48>;
        status = "disabled";
        phandle = <0xC7>;
