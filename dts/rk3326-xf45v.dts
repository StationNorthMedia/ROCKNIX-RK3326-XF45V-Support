    battery {
        compatible = "simple-battery";
        charge-full-design-microamp-hours = <0x3D0900>;
        charge-term-current-microamp = <0x30D40>;
        constant-charge-current-max-microamp = <0x16E360>;
        constant-charge-voltage-max-microvolt = <0x401640>;
        factory-internal-resistance-micro-ohms = <0x186A0>;
        voltage-max-design-microvolt = <0x3E8FA0>;
        voltage-min-design-microvolt = <0x325AA0>;
        ocv-capacity-celsius = <0x14>;
        ocv-capacity-table-0 = <0x3DC066 0x64 0x3D1080 0x5F 0x3C8B9C 0x5A 0x3C1EA0 0x55 0x3BA970 0x50 0x3B0D30 0x4B 0x3A70F0 0x46 0x39D4B0 0x41 0x393870 0x3C 0x38C340 0x37 0x384E10 0x32 0x37B1D0 0x2D 0x371590 0x28 0x367950 0x23 0x360420 0x1E 0x3567E0 0x19 0x34CBA0 0x14 0x342F60 0xF 0x339320 0xA 0x32F6E0 0x5 0x325AA0 0x0>;
        phandle = <0x57>;
    };
    adc-keys {
        compatible = "adc-keys";
        io-channels = <0xA8 0x2>;
        io-channel-names = "buttons";
        keyup-threshold-microvolt = <0x1B7740>;
        poll-interval = <0x64>;
        status = "disabled";
        phandle = <0x13A>;
        button-vol-up {
            press-threshold-microvolt = <0x3A98>;
            label = "VOLUMEUP";
            linux,code = <0x73>;
        };
        button-vol-down {
            press-threshold-microvolt = <0x493E0>;
            label = "VOLUMEDOWN";
            linux,code = <0x72>;
        };
    };
    joypad {
        compatible = "rocknix-singleadc-joypad";
        joypad-name = "r36s_Gamepad";
        joypad-product = <0x1188>;
        joypad-revision = <0x188>;
        status = "okay";
        pinctrl-names = "default";
        pinctrl-0 = <0xA9>;
        io-channel-names = "amux_adc";
        io-channels = <0xA8 0x1>;
        amux-count = <0x4>;
        amux-channel-mapping = <0x3 0x2 0x0 0x1>;
        amux-en-gpios = <0xAA 0xB 0x1>;
        amux-a-gpios = <0xAA 0x10 0x1>;
        amux-b-gpios = <0xAA 0xF 0x1>;
        button-adc-scale = <0x2>;
        button-adc-deadzone = <0x40>;
        button-adc-fuzz = <0x20>;
        button-adc-flat = <0x20>;
        abs_x-p-tuning = <0xC8>;
        abs_x-n-tuning = <0xC8>;
        abs_y-p-tuning = <0xC8>;
        abs_y-n-tuning = <0xC8>;
        abs_rx-p-tuning = <0xC8>;
        abs_rx-n-tuning = <0xC8>;
        abs_ry-p-tuning = <0xC8>;
        abs_ry-n-tuning = <0xC8>;
        poll-interval = <0xA>;
        phandle = <0x13B>;
        invert-absx;
        invert-absry;
        sw1 {
            gpios = <0x94 0x16 0x1>;
            label = "GPIO DPAD-UP";
            linux,code = <0x220>;
        };
        sw2 {
            gpios = <0x94 0x17 0x1>;
            label = "GPIO DPAD-DOWN";
            linux,code = <0x221>;
        };
        sw3 {
            gpios = <0x94 0x14 0x1>;
            label = "GPIO DPAD-LEFT";
            linux,code = <0x222>;
        };
        sw4 {
            gpios = <0x94 0x15 0x1>;
            label = "GPIO DPAD-RIGHT";
            linux,code = <0x223>;
        };
        sw5 {
            gpios = <0x94 0x10 0x1>;
            label = "GPIO KEY BTN-A";
            linux,code = <0x131>;
        };
        sw6 {
            gpios = <0x94 0x11 0x1>;
            label = "GPIO BTN-B";
            linux,code = <0x130>;
        };
        sw7 {
            gpios = <0x94 0x13 0x1>;
            label = "GPIO BTN-Y";
            linux,code = <0x134>;
        };
        sw8 {
            gpios = <0x94 0x12 0x1>;
            label = "GPIO BTN-X";
            linux,code = <0x133>;
        };
        sw11 {
            gpios = <0xAA 0xD 0x1>;
            label = "GPIO BTN_THUMBL";
            linux,code = <0x13D>;
        };
        sw12 {
            gpios = <0xAA 0xE 0x1>;
            label = "GPIO BTN_THUMBR";
            linux,code = <0x13E>;
        };
        sw13 {
            gpios = <0x94 0x1A 0x1>;
            label = "GPIO BTN_FN";
            linux,code = <0x13C>;
        };
        sw15 {
            gpios = <0x94 0xD 0x1>;
            label = "GPIO TOP-LEFT";
            linux,code = <0x136>;
        };
        sw16 {
            gpios = <0x94 0xB 0x1>;
            label = "GPIO TOP-RIGHT";
            linux,code = <0x137>;
        };
        sw19 {
            gpios = <0x94 0x18 0x1>;
            label = "GPIO BTN_SELECT";
            linux,code = <0x13A>;
        };
        sw20 {
            gpios = <0x94 0x0 0x1>;
            label = "GPIO TOP-RIGHT2";
            linux,code = <0x139>;
        };
        sw21 {
            gpios = <0x94 0x6 0x1>;
            label = "GPIO TOP-LEFT2";
            linux,code = <0x138>;
        };
        sw22 {
            gpios = <0x94 0x19 0x1>;
            label = "GPIO BTN_START";
            linux,code = <0x13B>;
        };
